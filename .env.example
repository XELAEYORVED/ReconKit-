# ReconKit environment configuration
# Copy to .env and fill in. ALL keys are optional — ReconKit works without them
# (with reduced capabilities). API keys unlock advanced modules.

# --- Core ---
RECONKIT_DATABASE_URL=sqlite+aiosqlite:///./data/reconkit.db
RECONKIT_SECRET_KEY=change-me-to-a-long-random-string
RECONKIT_CACHE_BACKEND=disk          # disk | redis | none
RECONKIT_CACHE_TTL=86400             # seconds
RECONKIT_REDIS_URL=redis://localhost:6379/0
RECONKIT_MAX_CONCURRENCY=5
RECONKIT_DEFAULT_TIMEOUT=120

# --- Optional API keys (unlock advanced modules) ---
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
HUNTER_API_KEY=
OTX_API_KEY=
GITHUB_TOKEN=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
IPINFO_TOKEN=
HIBP_API_KEY=

# --- Web auth (first user bootstrap) ---
RECONKIT_ADMIN_USER=admin
RECONKIT_ADMIN_PASSWORD=changeme
RECONKIT_REQUIRE_AUTH=false
